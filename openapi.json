  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Liveness probe: returns 200 if process is alive.\n\nUse for load balancer or container liveness checks.\nThis endpoint does NOT check dependencies - it only confirms the process is running.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Readiness probe: returns 200 if all dependencies are healthy.\n\nUse for Kubernetes readiness gate or deployment health checks.\nReturns 503 if any critical dependency is unavailable.",
        "operationId": "readiness_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Service not ready"
          }
        }
      }
    },
    "/dependencies": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Dependency Status",
        "description": "Dependency probe: returns status and latency for all external dependencies.\n\nUse for monitoring dashboards and alerting.\nAlways returns 200 regardless of dependency health - check individual statuses.",
        "operationId": "dependency_status_dependencies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Version",
        "description": "Version endpoint: returns application version, environment, and uptime.\n\nUse for deployment verification and monitoring.",
