# Lockd'In root-level environment inventory (safe defaults only)
# Copy to .env and fill secrets locally.

# Product identity
APP_NAME=lockdin
APP_ENV=local
APP_LOG_LEVEL=INFO

# Backend runtime
LOCKDIN_API_HOST=127.0.0.1
LOCKDIN_API_PORT=8000
LOCKDIN_WEB_ORIGIN=http://localhost:3000

# Data stores
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lockdin
REDIS_URL=redis://localhost:6379/0

# OAuth (never commit real values)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# AI routing hints (non-secret defaults)
MODEL_ROUTER_DEFAULT=balanced
MODEL_ROUTER_PRIVACY_TIER=local_first
